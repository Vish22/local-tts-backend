# Copier en .env puis renseigner, puis : chmod 600 .env
# Ne jamais committer ce fichier (il est listé dans .dockerignore et .gitignore).

# Jeton partagé avec le client Hermes : obligatoire, toutes les routes /say et /audio l'exigent.
# Générer par exemple :  openssl rand -hex 32
# Variable d'environnement = jeton visible dans `docker inspect`. Alternative plus propre :
#   printf '%s' '<jeton>' > /etc/neutts.jeton && chmod 600 /etc/neutts.jeton
# puis utiliser NEUTTS_TOKEN_FILE (cf. README, § Sécurité).
NEUTTS_TOKEN=

# Jeton Hugging Face : obligatoire, les dépôts neutts-nano-french-q4-gguf et neucodec sont soumis à autorisation.
# Réutiliser celui déjà présent sur Hermes (~/.hermes/neutts.env) ou en créer un avec accès « read ».
HF_TOKEN=

# Écoute du port publié (IP LAN de l'hôte portgpu). Ne pas mettre 0.0.0.0.
NEUTTS_BIND_HOST=10.1.33.71
